{
  "cli": {
    "version": ">= 16.16.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "autoIncrement": true,
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
        "EXPO_PUBLIC_ZOHO_IOS_APP_KEY": "@EXPO_PUBLIC_ZOHO_IOS_APP_KEY",
        "EXPO_PUBLIC_ZOHO_IOS_ACCESS_KEY": "@EXPO_PUBLIC_ZOHO_IOS_ACCESS_KEY",
        "EXPO_PUBLIC_ZOHO_ANDROID_APP_KEY": "@EXPO_PUBLIC_ZOHO_ANDROID_APP_KEY",
        "EXPO_PUBLIC_ZOHO_ANDROID_ACCESS_KEY": "@EXPO_PUBLIC_ZOHO_ANDROID_ACCESS_KEY"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "channel": "testflight",
      "distribution": "store",
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6760278690",
        "appleId": "Akinolaoluwatosin45@gmail.com",
        "appleTeamId": "Y2V872NR45"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6760278690",
        "appleId": "Akinolaoluwatosin45@gmail.com",
        "appleTeamId": "Y2V872NR45"
      },
      "android": {
        "serviceAccountKeyPath": "./android-service-account.json",
        "track": "production"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6760278690",
        "appleId": "aremu_umera@icloud.com",
        "appleTeamId": "Y2V872NR45"
      },
      "android": {
        "serviceAccountKeyPath": "./android-service-account.json",
        "track": "internal"
      }
    }
  }
}